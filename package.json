{
  "name": "git-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "cargo test --workspace && node --test tests/*.test.mjs && pnpm bindings:check",
    "bindings:generate": "cargo run -q -p git-gui-core --example bindings > src/git/bindings.ts",
    "bindings:check": "node scripts/check-bindings.mjs",
    "package:deb": "node scripts/package-deb.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.42.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.552.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
